{
  "name": "rupeekit-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:discover-images && next build",
    "postbuild": "npm run validate:discover-rendered && npm run validate:direct-answer-rendered",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "report:gsc": "node scripts/gsc-report.mjs",
    "validate": "npm run validate:tools && npm run validate:priority-growth && npm run validate:growth && npm run validate:ai-seo && npm run validate:content-seo && npm run validate:internal-links && npm run validate:financial-updates && npm run validate:gold-rates && npm run validate:discover-images",
    "validate:ai-seo": "node scripts/validate-ai-seo-readiness.mjs && node scripts/validate-structured-data.mjs",
    "validate:content-seo": "node scripts/validate-content-seo.mjs",
    "validate:growth": "node scripts/validate-growth-clusters.mjs",
    "validate:tools": "node scripts/validate-tools.mjs",
    "validate:priority-growth": "node scripts/validate-priority-search-growth.mjs",
    "validate:internal-links": "node scripts/validate-internal-links.mjs",
    "validate:financial-updates": "node scripts/validate-day18-financial-updates.mjs",
    "validate:discover-images": "node scripts/validate-discover-images.mjs",
    "validate:discover-rendered": "node scripts/validate-discover-rendered-output.mjs",
    "validate:direct-answer-rendered": "node scripts/validate-direct-answer-rendered-output.mjs",
    "validate:gold-rates": "node scripts/validate-gold-rates.mjs",
    "fetch:gold-rates": "node scripts/fetch-gold-rates.mjs",
    "probe:gold-providers": "node scripts/probe-gold-providers.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "expr-eval": "^2.0.2",
    "next": "14.2.23",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
